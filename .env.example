# Copiar a .env.local para desarrollo. En Vercel se cargan como Environment Variables.

# URL base de la app (sin barra final).
# Local: http://localhost:3000  |  Prod: https://eudromiac.club (o el dominio que asignemos en Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres en Render. Usar la "External Database URL" que da Render (postgres://...).
# Drizzle apunta acá. Render expone SSL obligatorio: agregar ?sslmode=require al final si no viene.
DATABASE_URL=

# Auth.js v5. Generar con: openssl rand -base64 32
AUTH_SECRET=

# Email del owner del club. El usuario con este email recibe rol admin al loguearse.
ADMIN_EMAIL=lemonscontacto@gmail.com

# MercadoPago Checkout Pro. Sacar del panel de MP (Credenciales → Producción/Test).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
